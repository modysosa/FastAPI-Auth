# Generate your own value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_NAME=FastAPI Auth Starter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Omit DATABASE_URL to use dev.db in the project directory.
# DATABASE_URL=sqlite:///./dev.db
# JSON array; only list trusted frontend origins.
CORS_ORIGINS=[]
LOG_LEVEL=INFO
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60
# Local single-process default. Use Redis for multiple workers/instances.
RATE_LIMIT_STORAGE_URI=memory://
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
# Give each project/environment a different prefix when sharing Redis.
RATE_LIMIT_PREFIX=fastapi-auth
